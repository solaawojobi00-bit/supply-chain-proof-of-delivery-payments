# Stellar network configuration
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Hash of the uploaded escrow contract WASM (from `stellar contract upload`)
ESCROW_WASM_HASH=replace-with-wasm-hash

# Stellar Asset Contract id for the token used as payment (native XLM on testnet)
PAYMENT_TOKEN_CONTRACT_ID=replace-with-sac-contract-id

# Phase 1 simplification: the backend holds these keys server-side to submit
# transactions on each party's behalf, since there is no wallet-connect UI yet.
# NEVER commit real secret keys. These must be testnet-only keypairs.
DEPLOYER_SECRET_KEY=replace-with-deployer-secret
BUYER_SECRET_KEY=replace-with-buyer-secret
SELLER_SECRET_KEY=replace-with-seller-secret
ATTESTOR_SECRET_KEY=replace-with-attestor-secret

PORT=4100
DB_PATH=./data/orders.sqlite

# CORS configuration (comma-separated allowed origins; empty by default, wildcard disallowed)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
