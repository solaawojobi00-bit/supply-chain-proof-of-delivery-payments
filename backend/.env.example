# Stellar network selection ("testnet" | "mainnet" | "local"). Defaults to "testnet".
STELLAR_NETWORK=testnet

# Stellar network configuration (Testnet)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Mainnet Configuration Example (Requires explicit ALLOW_MAINNET=true opt-in):
# ALLOW_MAINNET=true
# STELLAR_NETWORK=mainnet
# STELLAR_RPC_URL=https://mainnet.stellar.org:443
# STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; July 2015
# STELLAR_HORIZON_URL=https://horizon.stellar.org

# Hash of the uploaded escrow contract WASM (from `stellar contract upload`)
ESCROW_WASM_HASH=replace-with-wasm-hash

# Stellar Asset Contract id for the token used as payment (native XLM on testnet)
PAYMENT_TOKEN_CONTRACT_ID=replace-with-sac-contract-id

# Phase 1 simplification: the backend holds these keys server-side to submit
# transactions on each party's behalf, since there is no wallet-connect UI yet.
# NEVER commit real secret keys. These must be testnet-only keypairs.
DEPLOYER_SECRET_KEY=replace-with-deployer-secret
BUYER_SECRET_KEY=replace-with-buyer-secret
SELLER_SECRET_KEY=replace-with-seller-secret
ATTESTOR_SECRET_KEY=replace-with-attestor-secret

PORT=4100

# Persistence. Local development and tests use a libSQL file (or ":memory:").
# DB_PATH accepts a bare path or any libSQL URL.
DB_PATH=./data/orders.sqlite

# Hosted Turso database. When TURSO_DATABASE_URL is set it takes precedence over
# DB_PATH, which is how deployed instances get durable storage — a container
# filesystem does not survive a restart or redeploy.
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=replace-with-turso-auth-token

# Deployment guard. This service holds signing keys, so a public instance should
# refuse to start outside testnet. Set to true wherever the backend is hosted.
# REQUIRE_TESTNET=true

# CORS configuration (comma-separated allowed origins; empty by default, wildcard disallowed)
# The deployed frontend is a different origin from the backend, so its URL must
# be listed here or browser requests are rejected.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com

# Webhook payload signing. When set, every outgoing webhook carries an
# X-Signature: sha256=<hex> header (HMAC-SHA256 over "<timestamp>.<raw body>")
# and an X-Signature-Timestamp header. Leave unset to send unsigned deliveries.
# Use a high-entropy random value, e.g. `openssl rand -hex 32`. NEVER commit it.
# WEBHOOK_SIGNING_SECRET=replace-with-random-32-byte-hex
# Recommended replay tolerance in seconds, surfaced to consumers in the docs.
# WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# Rate Limiting Configuration
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_MUTATING=30
# RATE_LIMIT_MAX_GENERAL=300

# Express Trust Proxy Configuration (e.g. true, 1, 'loopback', false)
# TRUST_PROXY=false
