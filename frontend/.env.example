# Base URL of the escrow backend API.
#
# Substituted into index.html at build time (Vite replaces %VITE_API_BASE_URL%),
# so it must be set in the hosting provider's build environment, not at runtime.
# When unset, the app falls back to http://localhost:3000 for local development.
#
# The deployed frontend and backend are different origins, so this URL must also
# appear in the backend's CORS_ALLOWED_ORIGINS or the browser will block requests.
VITE_API_BASE_URL=http://localhost:4100
